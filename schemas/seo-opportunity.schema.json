{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CYBERDUDEBIVASH SEO Opportunity",
  "type": "object",
  "required": ["schema_version", "topic_id", "cluster", "query", "intent", "target_platform", "landing_path", "source_platforms", "internal_signals", "external_evidence"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "topic_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,119}$"},
    "cluster": {"type": "string", "minLength": 2, "maxLength": 80},
    "query": {"type": "string", "minLength": 2, "maxLength": 160},
    "intent": {"enum": ["informational", "commercial", "transactional", "navigational"]},
    "target_platform": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,119}$"},
    "landing_path": {"type": "string", "pattern": "^/[^?#]*$", "maxLength": 200},
    "source_platforms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,119}$"}},
    "internal_signals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategic_fit", "commercial_intent", "authority_fit", "landing_readiness", "content_gap"],
      "properties": {
        "strategic_fit": {"type": "integer", "minimum": 0, "maximum": 5},
        "commercial_intent": {"type": "integer", "minimum": 0, "maximum": 5},
        "authority_fit": {"type": "integer", "minimum": 0, "maximum": 5},
        "landing_readiness": {"type": "integer", "minimum": 0, "maximum": 5},
        "content_gap": {"type": "integer", "minimum": 0, "maximum": 5}
      }
    },
    "external_evidence": {
      "oneOf": [
        {"type": "object", "properties": {"status": {"const": "none"}}, "required": ["status"], "additionalProperties": false},
        {
          "type": "object",
          "properties": {
            "status": {"const": "verified"},
            "provider": {"type": "string"},
            "as_of": {"type": "string", "format": "date"},
            "demand_score": {"type": "integer", "minimum": 0, "maximum": 5},
            "competition_opportunity": {"type": "integer", "minimum": 0, "maximum": 5}
          },
          "required": ["status", "provider", "as_of", "demand_score", "competition_opportunity"],
          "additionalProperties": false
        }
      ]
    }
  }
}
