{
  "schema_version": 1,
  "default_publication_decision": "deny",
  "allowed_statuses": [
    "approved",
    "hold",
    "prohibited",
    "private-only"
  ],
  "authoritative_evidence_types": [
    "government-registration-record",
    "tax-registration-record",
    "government-recognition-record",
    "regulator-record",
    "certification-authority-record",
    "independent-market-research"
  ],
  "repository_scan": {
    "claim_scan_exclusions": [
      "config/claims-governance.json",
      "docs/CLAIMS-GOVERNANCE.md"
    ],
    "text_suffixes": [
      ".json",
      ".md",
      ".py",
      ".yml",
      ".yaml",
      ".txt",
      ".toml",
      ".ini",
      ".cfg",
      ".csv",
      ".html",
      ".js",
      ".jsx",
      ".ts",
      ".tsx",
      ".env",
      ".example"
    ]
  },
  "sensitive_identifier_policy": {
    "never_commit": [
      "PAN values",
      "GSTIN values",
      "Udyam registration numbers",
      "payment-provider plan identifiers",
      "live API or payment credentials"
    ],
    "patterns": {
      "pan": "(?<![A-Z0-9])[A-Z]{5}[0-9]{4}[A-Z](?![A-Z0-9])",
      "gstin": "(?<![A-Z0-9])[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][1-9A-Z]Z[0-9A-Z](?![A-Z0-9])",
      "udyam_registration": "(?i)\\bUDYAM-[A-Z]{2}-[0-9]{2}-[0-9]{7}\\b",
      "razorpay_plan_id": "\\bplan_[A-Za-z0-9]{8,}\\b",
      "stripe_price_id": "\\bprice_[A-Za-z0-9]{8,}\\b",
      "paypal_plan_id": "\\bP-[A-Z0-9]{10,}\\b",
      "razorpay_live_key": "\\brzp_live_[A-Za-z0-9]{8,}\\b",
      "stripe_live_secret": "\\bsk_live_[A-Za-z0-9]{12,}\\b",
      "github_classic_token": "\\bghp_[A-Za-z0-9]{20,}\\b",
      "github_fine_grained_token": "\\bgithub_pat_[A-Za-z0-9_]{20,}\\b"
    }
  },
  "prohibited_claim_rules": [
    {
      "id": "unverified-india-first-ai-native-platform",
      "pattern": "(?i)\\bindia(?:'|’)?s\\s+(?:1st|first)\\s+ai[-\\s]?native\\s+cybersecurity\\s+platform\\b"
    },
    {
      "id": "unapproved-brand-market-superlative",
      "pattern": "(?is)\\bCYBERDUDEBIVASH(?:®)?\\b.{0,100}\\b(?:#\\s*1|number\\s+one|market\\s+leader|world(?:'|’)?s\\s+(?:best|first|1st)|india(?:'|’)?s\\s+(?:best|leading|first|1st))\\b"
    },
    {
      "id": "unapproved-brand-market-superlative-reversed",
      "pattern": "(?is)\\b(?:#\\s*1|number\\s+one|market\\s+leader|world(?:'|’)?s\\s+(?:best|first|1st)|india(?:'|’)?s\\s+(?:best|leading|first|1st))\\b.{0,100}\\bCYBERDUDEBIVASH(?:®)?\\b"
    }
  ],
  "claim_detection_rules": [
    {
      "claim_id": "legal-entity-name",
      "pattern": "(?i)\\bCYBERDUDEBIVASH(?:®)?\\s+(?:PRIVATE\\s+LIMITED|PVT\\.?\\s*LTD\\.?|LIMITED|LLP|INC\\.?|LLC)\\b"
    },
    {
      "claim_id": "gst-registration",
      "pattern": "(?is)(?:\\bCYBERDUDEBIVASH(?:®)?\\b.{0,120}\\bGST(?:IN)?\\b|\\bGST(?:IN)?\\b.{0,120}\\bCYBERDUDEBIVASH(?:®)?\\b)"
    },
    {
      "claim_id": "msme-udyam-registration",
      "pattern": "(?is)(?:\\bCYBERDUDEBIVASH(?:®)?\\b.{0,120}\\b(?:MSME|UDYAM)\\b|\\b(?:MSME|UDYAM)\\b.{0,120}\\bCYBERDUDEBIVASH(?:®)?\\b)"
    },
    {
      "claim_id": "startup-india-recognition",
      "pattern": "(?is)(?:\\bCYBERDUDEBIVASH(?:®)?\\b.{0,120}\\bSTARTUP\\s+INDIA\\b|\\bSTARTUP\\s+INDIA\\b.{0,120}\\bCYBERDUDEBIVASH(?:®)?\\b)"
    }
  ],
  "claims": [
    {
      "id": "legal-entity-name",
      "category": "legal-entity",
      "status": "hold",
      "approved_public_wording": null,
      "reason": "No authoritative registration evidence reference is recorded in this public control plane."
    },
    {
      "id": "gst-registration",
      "category": "tax",
      "status": "hold",
      "approved_public_wording": null,
      "reason": "Tax-registration facts remain inactive until authoritative evidence is reviewed and public wording is approved."
    },
    {
      "id": "msme-udyam-registration",
      "category": "government-recognition",
      "status": "hold",
      "approved_public_wording": null,
      "reason": "MSME/Udyam facts remain inactive until authoritative evidence is reviewed and public wording is approved."
    },
    {
      "id": "startup-india-recognition",
      "category": "government-recognition",
      "status": "hold",
      "approved_public_wording": null,
      "reason": "Startup India facts remain inactive until authoritative evidence is reviewed and public wording is approved."
    },
    {
      "id": "payment-plan-identifiers",
      "category": "commercial-secret",
      "status": "private-only",
      "approved_public_wording": null,
      "public_disclosure": "forbidden",
      "reason": "Provider plan identifiers belong only in scoped private configuration or secrets."
    },
    {
      "id": "market-leadership-india-first-ai-native",
      "category": "market-leadership",
      "status": "prohibited",
      "approved_public_wording": null,
      "reason": "No independently supportable market evidence is recorded; the claim is retired from public use."
    },
    {
      "id": "public-location-wording",
      "category": "corporate-location",
      "status": "approved",
      "approved_public_wording": "Odisha, India",
      "evidence_type": "owner-confirmed-public-directory",
      "evidence_reference": "config/public-directory.json#/public_contact/location",
      "evidence_owner": "CYBERDUDEBIVASH owner",
      "approved_on": "2026-08-17",
      "review_due_on": "2027-08-17"
    }
  ]
}
