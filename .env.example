# External publishing is disabled by default.
# Add only through GitHub Actions / deployment secrets, never commit real credentials.
# LINKEDIN_ACCESS_TOKEN=
# X_BEARER_TOKEN=
# YOUTUBE_API_KEY=
# ANALYTICS_API_KEY=

# Private analytics connectors MUST NOT run in this public repository's GitHub Actions.
# Configure provider credentials only in an isolated private runner/environment.
# CDB_ANALYTICS_PROVIDER=manual-aggregate
# CLOUDFLARE_ANALYTICS_API_TOKEN=
# GA4_SERVICE_ACCOUNT_JSON=
